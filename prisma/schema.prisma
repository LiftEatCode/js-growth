  workstreamType String
  priority       String
  priorityScore  Int
  title          String
  summary        String
  sortOrder      Int

  /// Operator soft-remove; evidence JSON remains for auditability.
  removed Boolean @default(false)

  operatorNote String?

  capabilitiesJson            Json
  evidenceJson                Json
  actionsJson                 Json
  preservationConstraintsJson Json

  @@index([implementationPlanId, sortOrder])
  @@index([implementationPlanId, removed])
}

enum ImplementationInterpretationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// AI explanation of a deterministic ImplementationPlan (Commercial Sprint 2).
