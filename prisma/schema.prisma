/// Commercial Sprint 3 — sales opportunity (human-created commercial pursuit).
/// Intelligence is referenced, not recalculated. Scope / Pricing / Proposal are separate engines.
model Opportunity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Linked Implementation Plan snapshot at create/refresh time (nullable).
  implementationPlanId String?
  implementationPlan   ImplementationPlan? @relation(fields: [implementationPlanId], references: [id], onDelete: SetNull)

  /// Linked completed AI Implementation Strategy at create/refresh time (nullable).
  implementationInterpretationId String?
  implementationInterpretation   ImplementationPlanInterpretation? @relation(fields: [implementationInterpretationId], references: [id], onDelete: SetNull)

  name String

  stage OpportunityStage @default(NEW)

  ownerEmail String

  /// Snapshot of recommended ServiceCapabilityId values + provenance metadata.
  recommendedCapabilitiesJson Json

  nextAction   String?
  nextActionAt DateTime?

  wonAt  DateTime?
  lostAt DateTime?

  lostReason OpportunityLostReason?
  lostNote   String?

  createdByEmail String

  activities OpportunityActivity[]
  followUpActivities FollowUpActivity[]
  scopes     CommercialScope[]
  pricings   CommercialPricing[]
  proposals  CommercialProposal[]
  proposalDeliveries ProposalDelivery[]
  agreements CommercialAgreement[]
  agreementDeliveries AgreementDelivery[]
  commercialPayments CommercialPayment[]
  clientProject      ClientProject?

  /// Set when converted to a Client (Sprint 10).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
  @@index([campaignId, createdAt])
  @@index([stage, createdAt])
  @@index([ownerEmail, stage])
  @@index([nextActionAt])
  @@index([implementationPlanId])
  @@index([leadId])
  @@index([clientId])
}

/// Append-only sales timeline for an Opportunity.
model OpportunityActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  type OpportunityActivityType

  actorEmail String

  fromValueJson Json?
  toValueJson   Json?

  note String?

  @@index([opportunityId, createdAt])
  @@index([type, createdAt])
}

enum CommercialScopeStatus {
  DRAFT
  REVIEWED
  APPROVED
  SUPERSEDED
}

/// Commercial Sprint 4 — human-controlled commercial Scope for an Opportunity.
/// Recommendation → commercial offer definition. No pricing / proposals / OpenAI.
model CommercialScope {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Plan linked when scope was created/revised (nullable for manual scopes).
  implementationPlanId String?
  implementationPlan   ImplementationPlan? @relation(fields: [implementationPlanId], references: [id], onDelete: SetNull)

  /// Provenance only — AI strategy is never authoritative for scope.
  implementationInterpretationId String?
  implementationInterpretation   ImplementationPlanInterpretation? @relation(fields: [implementationInterpretationId], references: [id], onDelete: SetNull)

  status CommercialScopeStatus @default(DRAFT)

  /// Operator-facing revision number within the Opportunity (1, 2, …).
  revision Int @default(1)

  title   String
  summary String?

  scopeVersion     Int
  sourceFingerprint String

  /// [{ id, text, sortOrder, templateKey? }]
  assumptionsJson Json
  /// [{ id, text, sortOrder, templateKey? }]
  exclusionsJson Json
  /// Preservation / implementation considerations copied from plan (not billable sections).
  considerationsJson Json

  approvedAt      DateTime?
  approvedByEmail String?
  supersededAt    DateTime?

  createdByEmail String

  sections CommercialScopeSection[]
  pricings CommercialPricing[]
  proposals CommercialProposal[]
  agreements CommercialAgreement[]

  @@index([opportunityId, createdAt])
  @@index([opportunityId, status])
  @@index([implementationPlanId])
  @@index([status, createdAt])
}

model CommercialScopeSection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopeId String
  scope   CommercialScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  sourceImplementationWorkstreamId String?
  workstreamType                   String?

  title       String
  description String?

  sortOrder  Int
  isOptional Boolean @default(false)
  isIncluded Boolean @default(true)

  /// ServiceCapabilityId[] — active only on auto-map.
  capabilitiesJson Json

  /// PLAN | MANUAL
  source String @default("PLAN")

  deliverables CommercialScopeDeliverable[]

  @@index([scopeId, sortOrder])
  @@index([scopeId, isIncluded])
}

model CommercialScopeDeliverable {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectionId String
  section   CommercialScopeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  /// RecommendedAction.id from Implementation Plan when plan-derived.
  sourceActionKey String?

  title       String
  description String?

  /// IMPLEMENTATION | REVIEW | CONFIGURATION | CONTENT | TECHNICAL | OPTIMIZATION | OTHER
  deliverableType String @default("IMPLEMENTATION")

  sortOrder  Int
  isOptional Boolean @default(false)
  isIncluded Boolean @default(true)

  /// PLAN | MANUAL
  source String @default("PLAN")

  @@index([sectionId, sortOrder])
  @@index([sectionId, isIncluded])
}

enum CommercialPricingStatus {
  DRAFT
  REVIEWED
  APPROVED
  SUPERSEDED
}

/// Commercial Sprint 5 — deterministic Pricing recommendation for an approved Scope.
/// Human review/overrides → approved historical snapshot. No proposals / Stripe / OpenAI.
model CommercialPricing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  commercialScopeId String
  commercialScope   CommercialScope @relation(fields: [commercialScopeId], references: [id], onDelete: Cascade)

  status CommercialPricingStatus @default(DRAFT)

  /// Operator-facing revision number within the Opportunity (1, 2, …).
  revision Int @default(1)

  currency String @default("USD")

  pricingVersion       Int
  pricingConfigVersion Int
  sourceFingerprint    String

  recommendedIncludedCents Int
  recommendedOptionalCents Int
  recommendedTotalCents    Int

  finalIncludedCents Int
  finalOptionalCents Int
  finalTotalCents    Int

  minimumEngagementCents Int
  minimumApplied         Boolean @default(false)
  assessmentOnly         Boolean @default(false)

  notes String?

  approvedAt      DateTime?
  approvedByEmail String?
  supersededAt    DateTime?

  createdByEmail String

  lineItems CommercialPricingLineItem[]
  proposals CommercialProposal[]
  agreements CommercialAgreement[]

  @@index([opportunityId, createdAt])
  @@index([opportunityId, status])
  @@index([commercialScopeId])
  @@index([status, createdAt])
}

model CommercialPricingLineItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingId String
  pricing   CommercialPricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  /// Canonical commercial work-unit key (dedupe identity).
  workUnitKey String

  title String

  /// IMPLEMENTATION | REVIEW | CONFIGURATION | CONTENT | TECHNICAL | OPTIMIZATION | ASSESSMENT | CUSTOM | OTHER
  workType String

  /// SMALL | MEDIUM | LARGE | ASSESSMENT | CUSTOM
  effortBand String

  quantity Int @default(1)

  /// Deterministic recommendation (null when CUSTOM / no band price).
  recommendedUnitPriceCents Int?
  recommendedLineTotalCents Int?

  /// Operator final price (null until set for CUSTOM or override).
  finalUnitPriceCents Int?
  finalLineTotalCents Int?

  isOptional   Boolean @default(false)
  isIncluded   Boolean @default(true)
  isCustom     Boolean @default(false)
  isOverridden Boolean @default(false)

  overrideReason String?

  /// Scope deliverable ids contributing to this work unit.
  sourceDeliverableIdsJson Json
  /// Section titles contributing to this work unit (multi-section provenance).
  sourceSectionTitlesJson  Json

  sortOrder Int

  @@index([pricingId, sortOrder])
  @@index([pricingId, workUnitKey])
  @@index([pricingId, isIncluded])
}

enum CommercialProposalStatus {
  DRAFT
  REVIEWED
  APPROVED
  SUPERSEDED
}

