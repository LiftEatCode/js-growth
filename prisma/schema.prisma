generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  FOLLOW_UP_CHANGED
  NOTES_UPDATED
  MANUAL_NOTE
}

enum AuditReportSource {
  PUBLIC_FUNNEL
  PROSPECTING
}

model AuditReport {
  id        String   @id
  version   Int
  createdAt DateTime @default(now())

  website    String
  hostname   String
  reportMode String

  /// Distinguishes inbound Website Growth Audit reports from internal
  /// prospecting scans. Does not change Free/Professional reportMode.
  source AuditReportSource @default(PUBLIC_FUNNEL)

  overallScore Int
  grade        String

  criticalIssues   Int
  quickWins        Int
  opportunityScore Int

  audit Json

  leadId String?

  lead Lead? @relation(fields: [leadId], references: [id])

  purchases ReportPurchase[]

  prospects Prospect[]

  outreachMessages OutreachMessage[]

  competitiveComparisons CompetitiveComparisonSnapshot[]

  implementationPlans ImplementationPlan[]

  aiStatus         AiInterpretationStatus?
  aiAttemptCount   Int                     @default(0)
  aiStartedAt      DateTime?
  aiGeneratedAt    DateTime?
  aiInterpretation Json?

  @@index([hostname])
  @@index([createdAt])
  @@index([overallScore])
  @@index([grade])
  @@index([opportunityScore])
  @@index([source])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String

  email String

  phone String?

  company String?

  website String

  contacted Boolean @default(false)

  status LeadStatus @default(NEW)

  followUpAt DateTime?

  notes String?

  reports AuditReport[]

  activities LeadActivity[]

  prospects Prospect[]

  implementationPlans ImplementationPlan[]

  @@index([email])
  @@index([website])
  @@index([status])
  @@index([followUpAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type LeadActivityType

  description String

  fromValue String?

  toValue String?

  leadId String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
  @@index([type])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AiInterpretationStatus {
  GENERATING
  COMPLETED
  FAILED
}

model ReportPurchase {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  reportId String
  report   AuditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String? @unique
  stripeCustomerId        String?
  customerEmail           String?

  amountTotal Int?
  currency    String?

  status PurchaseStatus @default(PENDING)

  // REFUNDED is reserved for later refund handling. V1 does not revoke
  // Professional access automatically when a Stripe refund occurs.

  @@index([reportId])
  @@index([status])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum ProspectSourceType {
  MANUAL
  PROVIDER
  WEBSITE
  GOOGLE_PLACES
}

enum ProspectQualificationStatus {
  DISCOVERED
  WEBSITE_INVALID
  AUDITING
  AUDIT_FAILED
  QUALIFIED
  SKIPPED
}

enum ProspectOutreachStatus {
  NOT_READY
  CONTACT_FOUND
  NO_CONTACT
  CONTACT_DISCOVERY_FAILED
  DRAFT_READY
  DRAFT_GENERATION_FAILED
  SUPPRESSED
  APPROVED
  SENT
  REPLIED
  INTERESTED
  NOT_INTERESTED
  CONVERTED
}

enum ProspectContactSourceType {
  WEBSITE
  CONTACT_PAGE
  PROVIDER
  MANUAL
  WEBSITE_HOMEPAGE
  WEBSITE_CONTACT_PAGE
  WEBSITE_ABOUT_PAGE
  WEBSITE_TEAM_PAGE
  WEBSITE_OTHER
}

enum ProspectContactStatus {
  DISCOVERED
  SELECTED
  REJECTED
  SUPPRESSED
  STALE
}

enum ProspectContactConfidence {
  HIGH
  MEDIUM
  LOW
}

enum OutreachMessageStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  SENDING
  REJECTED
  SENT
  SUBMITTED
  FAILED
  CANCELLED
  SUPPRESSED
}

enum OutreachChannel {
  EMAIL
  CONTACT_FORM
}

enum OutreachDeliveryProvider {
  RESEND
}

enum OutreachDeliveryEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  FAILED
  BOUNCED
  COMPLAINED
  SUPPRESSED
}

enum ProviderDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  DELAYED
  FAILED
  BOUNCED
  COMPLAINED
  SUPPRESSED
}

enum SuppressionType {
  HOSTNAME
  EMAIL
}

enum SuppressionReason {
  SENT
  REPLIED_NOT_INTERESTED
  CUSTOMER
  OPTED_OUT
  BOUNCED
  COMPLAINT
  MANUAL
  CONVERTED
}

enum OutreachOutcomeType {
  REPLIED
  INTERESTED
  NOT_INTERESTED
  NO_RESPONSE
  BOUNCED
}

model Campaign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  status CampaignStatus @default(DRAFT)

  locationLabel String
  city          String?
  state         String?
  radiusMiles   Int?

  industries String[]

  desiredQualifiedCount Int @default(5)

  targeting Json?

  notes String?

  createdByEmail String

  campaignProspects CampaignProspect[]

  outreachMessages OutreachMessage[]

  discoveryRuns          ProspectDiscoveryRun[]
  qualificationRuns      ProspectQualificationRun[]
  contactDiscoveryRuns   ProspectContactDiscoveryRun[]
  outreachDraftRuns      ProspectOutreachDraftRun[]
  competitorDiscoveryRuns CompetitorDiscoveryRun[]
  competitorAuditRuns     CompetitorAuditRun[]
  competitorAudits        CompetitorAudit[]
  competitiveComparisons  CompetitiveComparisonSnapshot[]
  competitiveInterpretations CompetitiveInterpretation[]
  implementationPlans     ImplementationPlan[]

  @@index([status])
  @@index([createdAt])
}

model Prospect {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessName String

  website  String?
  hostname String?

  industry String?
  city     String?
  state    String?
  address  String?
  phone    String?

  latitude  Float?
  longitude Float?

  sourceType ProspectSourceType @default(MANUAL)
  sourceRef  String?

  discoveredAt DateTime @default(now())

  qualificationStatus ProspectQualificationStatus @default(DISCOVERED)
  outreachStatus      ProspectOutreachStatus      @default(NOT_READY)

  skipReason String?
  notes      String?

  lastContactDiscoveryAt     DateTime?
  lastCompetitorDiscoveryAt  DateTime?

  auditReportId String?
  auditReport   AuditReport? @relation(fields: [auditReportId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  campaignProspects           CampaignProspect[]
  contacts                    ProspectContact[]
  contactForms                ProspectContactForm[]
  outreachMessages            OutreachMessage[]
  outreachOutcomes            OutreachOutcome[]
  importedDiscoveryCandidates ProspectDiscoveryCandidate[]
  competitors                 ProspectCompetitor[]         @relation("ProspectCompetitors")
  competitorOf                ProspectCompetitor[]         @relation("CompetitorProspectLink")
  competitorDiscoveryRuns     CompetitorDiscoveryRun[]
  competitorAuditRuns         CompetitorAuditRun[]
  competitorAudits            CompetitorAudit[]            @relation("TargetProspectCompetitorAudits")
  competitiveComparisons      CompetitiveComparisonSnapshot[]
  competitiveInterpretations  CompetitiveInterpretation[]
  implementationPlans         ImplementationPlan[]

  @@index([hostname])
  @@index([sourceRef])
  @@index([qualificationStatus])
  @@index([outreachStatus])
  @@index([discoveredAt])
  @@index([auditReportId])
  @@index([leadId])
}

model CampaignProspect {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  discoveryRank     Int?
  qualificationRank Int?

  isSelectedTopN Boolean @default(false)

  /// Human operator override: include this qualified prospect in outreach
  /// workflows without changing Top N ranking. Preserved across Top N recalculation.
  isSelectedForOutreach Boolean @default(false)

  qualificationJson Json?

  @@unique([campaignId, prospectId])
  @@index([campaignId])
  @@index([prospectId])
}

model ProspectContact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discoveredAt   DateTime  @default(now())
  lastVerifiedAt DateTime?

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  email           String
  normalizedEmail String
  name            String?
  role            String?

  sourceType ProspectContactSourceType
  sourceUrl  String?

  confidence ProspectContactConfidence
  status     ProspectContactStatus     @default(DISCOVERED)

  isPrimary Boolean @default(false)

  outreachMessages OutreachMessage[]

  @@unique([prospectId, normalizedEmail])
  @@index([prospectId])
  @@index([normalizedEmail])
  @@index([email])
}

model ProspectContactForm {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discoveredAt   DateTime  @default(now())
  lastVerifiedAt DateTime?

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  url          String
  normalizedUrl String
  sourcePageUrl String

  formMethod String?
  formAction String?

  detectedFieldsJson Json?

  confidence ProspectContactConfidence
  status     ProspectContactStatus     @default(DISCOVERED)

  isPrimary Boolean @default(false)

  outreachMessages OutreachMessage[]

  @@unique([prospectId, normalizedUrl])
  @@index([prospectId])
  @@index([normalizedUrl])
}

model OutreachMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  contactId String?
  contact   ProspectContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  contactFormId String?
  contactForm   ProspectContactForm? @relation(fields: [contactFormId], references: [id], onDelete: SetNull)

  channel OutreachChannel @default(EMAIL)

  auditReportId String?
  auditReport   AuditReport? @relation(fields: [auditReportId], references: [id], onDelete: SetNull)

  toEmail   String?
  fromEmail String?
  replyTo   String?

  subject  String @default("")
  bodyText String

  findingIds         String[]
  primaryFindingId   String?
  secondaryFindingId String?

  status OutreachMessageStatus @default(DRAFT)

  generationModel        String?
  generationAttemptCount Int     @default(1)
  promptTokens           Int?
  completionTokens       Int?
  generationJson         Json?

  providerMessageId String?
  sentAt            DateTime?
  submittedAt       DateTime?
  submittedByEmail  String?
  error             String?

  deliveredAt        DateTime?
  deliveryDelayedAt  DateTime?
  failedAt           DateTime?
  bouncedAt          DateTime?
  complainedAt       DateTime?
  providerSuppressedAt DateTime?
  providerDeliveryStatus ProviderDeliveryStatus?

  approvedAt      DateTime?
  approvedByEmail String?

  outcomes        OutreachOutcome[]
  deliveryEvents  OutreachDeliveryEvent[]

  @@index([prospectId])
  @@index([campaignId])
  @@index([contactId])
  @@index([contactFormId])
  @@index([auditReportId])
  @@index([status])
  @@index([channel])
  @@index([providerMessageId])
  @@index([providerDeliveryStatus])
}

model OutreachDeliveryEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  outreachMessageId String
  outreachMessage   OutreachMessage @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)

  provider           OutreachDeliveryProvider @default(RESEND)
  providerEventId    String?
  providerMessageId  String
  eventType          OutreachDeliveryEventType
  occurredAt         DateTime
  receivedAt         DateTime @default(now())
  payloadFingerprint String
  safeMetadataJson   Json?

  @@unique([payloadFingerprint])
  @@index([outreachMessageId])
  @@index([providerMessageId])
  @@index([eventType])
  @@index([occurredAt])
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type   SuppressionType
  value  String
  reason SuppressionReason

  @@index([type, value])
}

enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum DiscoveryCandidateStatus {
  ELIGIBLE
  NO_WEBSITE
  INVALID_WEBSITE
  DUPLICATE_PLACE
  DUPLICATE_HOSTNAME
  EXISTING_PROSPECT
  ALREADY_IN_CAMPAIGN
  EXISTING_LEAD
  SUPPRESSED
}

model ProspectDiscoveryRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  provider String
  status   DiscoveryRunStatus @default(RUNNING)

  requestedIndustries String[]
  requestedLocation   String
  radiusMiles         Int?
  requestedLimit      Int

  providerRequestCount Int @default(0)

  returnedCount          Int @default(0)
  eligibleCount          Int @default(0)
  importedCount          Int @default(0)
  skippedDuplicateCount  Int @default(0)
  skippedSuppressedCount Int @default(0)
  skippedNoWebsiteCount  Int @default(0)

  errorMessage String?

  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdByEmail String

  candidates ProspectDiscoveryCandidate[]

  @@index([campaignId, status])
  @@index([campaignId, createdAt])
}

model ProspectDiscoveryCandidate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  discoveryRunId String
  discoveryRun   ProspectDiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)

  providerBusinessId String
  businessName       String
  website            String?
  hostname           String?
  formattedAddress   String?
  city               String?
  state              String?
  phone              String?
  category           String?
  latitude           Float?
  longitude          Float?

  status          DiscoveryCandidateStatus
  exclusionReason String?

  importedProspectId String?
  importedProspect   Prospect? @relation(fields: [importedProspectId], references: [id], onDelete: SetNull)

  @@unique([discoveryRunId, providerBusinessId])
  @@index([discoveryRunId, status])
  @@index([hostname])
  @@index([importedProspectId])
}

enum QualificationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ProspectQualificationRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status QualificationRunStatus @default(RUNNING)

  requestedCount Int
  processedCount Int @default(0)
  qualifiedCount Int @default(0)
  skippedCount   Int @default(0)
  failedCount    Int @default(0)

  auditsAttempted Int @default(0)
  auditsReused    Int @default(0)
  auditsCompleted Int @default(0)
  auditsFailed    Int @default(0)

  remainingUnaudited Int @default(0)
  durationMs         Int @default(0)

  errorMessage String?

  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdByEmail String

  @@index([campaignId, status])
  @@index([campaignId, createdAt])
}

model ProspectContactDiscoveryRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status DiscoveryRunStatus @default(RUNNING)

  requested  Int
  processed  Int @default(0)
  found      Int @default(0)
  noContact  Int @default(0)
  failed     Int @default(0)
  reused     Int @default(0)
  suppressed Int @default(0)

  durationMs Int @default(0)

  errorMessage String?

  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdByEmail String

  @@index([campaignId, status])
  @@index([campaignId, createdAt])
}

model ProspectOutreachDraftRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status DiscoveryRunStatus @default(RUNNING)

  requested Int
  processed Int @default(0)
  generated Int @default(0)
  reused    Int @default(0)
  failed    Int @default(0)
  skipped   Int @default(0)

  durationMs Int @default(0)

  errorMessage String?

  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdByEmail String

  @@index([campaignId, status])
  @@index([campaignId, createdAt])
}

model OutreachOutcome {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreachMessageId String
  outreachMessage   OutreachMessage @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  outcome OutreachOutcomeType

  occurredAt DateTime @default(now())

  notes String?

  recordedByEmail String

  @@index([outreachMessageId])
  @@index([prospectId])
  @@index([outcome])
  @@index([occurredAt])
}

enum ProspectCompetitorStatus {
  CANDIDATE
  VALIDATED
  SELECTED
  REJECTED
  STALE
}

enum ProspectCompetitorValidationLabel {
  STRONG
  LIKELY
  WEAK
  REJECTED
}

model ProspectCompetitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectId String
  prospect   Prospect @relation("ProspectCompetitors", fields: [prospectId], references: [id], onDelete: Cascade)

  competitorProspectId String?
  competitorProspect   Prospect? @relation("CompetitorProspectLink", fields: [competitorProspectId], references: [id], onDelete: SetNull)

  provider           String
  providerBusinessId String

  businessName       String
  website            String?
  normalizedHostname String?

  formattedAddress String?
  city             String?
  state            String?
  latitude         Float?
  longitude        Float?

  primaryType             String?
  normalizedVerticalsJson Json?

  distanceMiles   Float?
  validationScore Int
  validationLabel ProspectCompetitorValidationLabel
  evidenceJson    Json

  status        ProspectCompetitorStatus @default(CANDIDATE)
  isRecommended Boolean                  @default(false)

  discoveredAt    DateTime @default(now())
  lastValidatedAt DateTime @default(now())

  audits CompetitorAudit[]

  @@unique([prospectId, provider, providerBusinessId])
  @@index([prospectId, status])
  @@index([prospectId, isRecommended])
  @@index([normalizedHostname])
  @@index([competitorProspectId])
}

enum CompetitorAuditStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Internal Website Growth Audit snapshot for a human-selected competitor.
/// Not an AuditReport — never enters public /report/* surfaces.
model CompetitorAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectCompetitorId String
  prospectCompetitor   ProspectCompetitor @relation(fields: [prospectCompetitorId], references: [id], onDelete: Cascade)

  targetProspectId String
  targetProspect   Prospect @relation("TargetProspectCompetitorAudits", fields: [targetProspectId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  runId String?
  run   CompetitorAuditRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  websiteUrl         String
  normalizedHostname String

  status CompetitorAuditStatus @default(PENDING)

  overallScore Int?
  grade        String?

  technicalScore     Int?
  seoScore           Int?
  contentScore       Int?
  croScore           Int?
  accessibilityScore Int?
  localScore         Int?
  performanceScore   Int?

  criticalIssues Int?
  quickWins      Int?
  pagesScanned   Int?

  /// Full WebsiteAuditResult JSON from the shared deterministic engine.
  auditResultJson Json?
  summaryJson     Json?

  /// Matches AuditReport.version / AUDIT_REPORT_VERSION for Sprint 11 compatibility.
  auditEngineVersion Int

  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  @@index([prospectCompetitorId, completedAt])
  @@index([targetProspectId, status])
  @@index([campaignId, createdAt])
  @@index([status, completedAt])
  @@index([runId])
}

/// Deterministic prospect-vs-competitor comparison snapshot (Sprint 11).
/// Not a public report. No AI. No network. Historical point-in-time facts.
model CompetitiveComparisonSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  auditReportId String
  auditReport   AuditReport @relation(fields: [auditReportId], references: [id], onDelete: Cascade)

  auditEngineVersion Int
  comparisonVersion  Int

  comparisonJson            Json
  competitorAuditIdsJson    Json
  selectedCompetitorIdsJson Json

  createdByEmail String

  interpretations CompetitiveInterpretation[]

  implementationPlans ImplementationPlan[]

  @@index([prospectId, campaignId, createdAt])
  @@index([auditReportId])
  @@index([createdAt])
}

enum CompetitiveInterpretationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// AI explanation of a Sprint 11 CompetitiveComparisonSnapshot.
/// Interpretation only — never recalculates comparison facts.
model CompetitiveInterpretation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  comparisonSnapshotId String
  comparisonSnapshot   CompetitiveComparisonSnapshot @relation(fields: [comparisonSnapshotId], references: [id], onDelete: Cascade)

  status CompetitiveInterpretationStatus @default(PENDING)

  model                   String?
  promptVersion           Int
  interpretationVersion   Int
  comparisonVersion       Int
  auditEngineVersion      Int
  inputFingerprint        String

  interpretationJson Json?

  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  failureCode   String?
  failureMessage String?

  createdByEmail String

  @@index([prospectId, campaignId, createdAt])
  @@index([comparisonSnapshotId, createdAt])
  @@index([status, createdAt])
  @@index([inputFingerprint])
}

model CompetitorAuditRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  status DiscoveryRunStatus @default(RUNNING)

  requestedAudits Int
  processedAudits Int @default(0)
  completedCount  Int @default(0)
  reusedCount     Int @default(0)
  failedCount     Int @default(0)
  skippedCount    Int @default(0)

  durationMs   Int     @default(0)
  errorMessage String?

  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdByEmail String

  audits CompetitorAudit[]

  @@index([campaignId, status])
  @@index([prospectId, createdAt])
  @@index([createdAt])
}

model CompetitorDiscoveryRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  status DiscoveryRunStatus @default(RUNNING)

  requestedProspects Int
  processedProspects Int @default(0)
  providerRequests   Int @default(0)
  candidatesReturned Int @default(0)
  validatedCount     Int @default(0)
  rejectedCount      Int @default(0)
  recommendedCount   Int @default(0)
  selectedCount      Int @default(0)
  reusedCount        Int @default(0)
  failedCount        Int @default(0)

  durationMs   Int     @default(0)
  errorMessage String?

  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdByEmail String

  @@index([campaignId, status])
  @@index([prospectId, createdAt])
  @@index([createdAt])
}

enum ImplementationPlanStatus {
  DRAFT
  REVIEWED
  APPROVED
  SUPERSEDED
}

/// Deterministic Implementation Recommendation snapshot (Commercial Sprint 1).
/// Facts → capabilities → workstreams. No AI. No pricing. Internal only.
model ImplementationPlan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  auditReportId String
  auditReport   AuditReport @relation(fields: [auditReportId], references: [id], onDelete: Cascade)

  comparisonSnapshotId String?
  comparisonSnapshot   CompetitiveComparisonSnapshot? @relation(fields: [comparisonSnapshotId], references: [id], onDelete: SetNull)

  status ImplementationPlanStatus @default(DRAFT)

  planVersion       Int
  mappingVersion    Int
  capabilityVersion Int
  inputFingerprint  String

  competitiveEvidenceUsed Boolean @default(false)

  operatorNotes String?

  approvedAt      DateTime?
  approvedByEmail String?
  supersededAt    DateTime?

  createdByEmail String

  workstreams ImplementationPlanWorkstream[]

  @@index([prospectId, campaignId, createdAt])
  @@index([auditReportId])
  @@index([comparisonSnapshotId])
  @@index([status, createdAt])
  @@index([leadId])
}

model ImplementationPlanWorkstream {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  implementationPlanId String
  implementationPlan   ImplementationPlan @relation(fields: [implementationPlanId], references: [id], onDelete: Cascade)

  workstreamType String
  priority       String
  priorityScore  Int
  title          String
  summary        String
  sortOrder      Int

  /// Operator soft-remove; evidence JSON remains for auditability.
  removed Boolean @default(false)

  operatorNote String?

  capabilitiesJson            Json
  evidenceJson                Json
  actionsJson                 Json
  preservationConstraintsJson Json

  @@index([implementationPlanId, sortOrder])
  @@index([implementationPlanId, removed])
}
