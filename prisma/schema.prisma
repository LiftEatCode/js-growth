  snapshotJson Json

  proposalVersion      Int
  presentationVersion  Int
  sourceFingerprint    String

  approvedAt      DateTime?
  approvedByEmail String?
  supersededAt    DateTime?

  createdByEmail String

  deliveries ProposalDelivery[]
  agreements CommercialAgreement[]

  @@index([opportunityId, createdAt])
  @@index([opportunityId, status])
  @@index([commercialScopeId])
  @@index([commercialPricingId])
  @@index([status, createdAt])
