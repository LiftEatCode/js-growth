generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  FOLLOW_UP_CHANGED
  NOTES_UPDATED
  MANUAL_NOTE
}

model AuditReport {
  id        String   @id
  version   Int
  createdAt DateTime @default(now())

  website    String
  hostname   String
  reportMode String

  overallScore Int
  grade        String

  criticalIssues   Int
  quickWins        Int
  opportunityScore Int

  audit Json

  leadId String?

  lead Lead? @relation(fields: [leadId], references: [id])

  purchases ReportPurchase[]

  @@index([hostname])
  @@index([createdAt])
  @@index([overallScore])
  @@index([grade])
  @@index([opportunityScore])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String

  email String

  phone String?

  company String?

  website String

  contacted Boolean @default(false)

  status LeadStatus @default(NEW)

  followUpAt DateTime?

  notes String?

  reports AuditReport[]

  activities LeadActivity[]

  @@index([email])
  @@index([website])
  @@index([status])
  @@index([followUpAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type LeadActivityType

  description String

  fromValue String?

  toValue String?

  leadId String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
  @@index([type])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model ReportPurchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  paidAt    DateTime?

  reportId String
  report   AuditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String? @unique
  stripeCustomerId        String?
  customerEmail           String?

  amountTotal Int?
  currency    String?

  status PurchaseStatus @default(PENDING)

  // REFUNDED is reserved for later refund handling. V1 does not revoke
  // Professional access automatically when a Stripe refund occurs.

  @@index([reportId])
  @@index([status])
}
