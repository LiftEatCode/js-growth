/// Manual Facebook content ledger. Facebook metrics are operator-entered.
/// First-party website/commercial outcomes remain separate (attributionJson / DB).
model GrowthContentRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platform      GrowthContentPlatform      @default(FACEBOOK)
  publisherType GrowthContentPublisherType
  publishedAt   DateTime

  contentJob    GrowthContentJob
  contentPillar GrowthContentPillar
  contentFormat GrowthContentFormat

  /// Bounded marketing campaign slug (no PII / commercial IDs).
  campaign String @db.VarChar(80)

  /// Bounded utm_content value (e.g. company_seo_mistakes_001).
  utmContent String @db.VarChar(80)

  /// Optional public Facebook post URL.
  postUrl String? @db.VarChar(500)

  title String  @db.VarChar(200)
  notes String? @db.VarChar(2000)

  /// Manual Facebook Insights metrics (never invent zeros for unknown).
  fbViews           Int?
  fbReach           Int?
  fbEngagements     Int?
  fbReactions       Int?
  fbComments        Int?
  fbShares          Int?
  fbPageVisits      Int?
  fbFollowersGained Int?
  fbLinkClicks      Int?

  createdByEmail String

  @@index([platform, publishedAt])
  @@index([publisherType, publishedAt])
  @@index([contentJob, publishedAt])
  @@index([contentPillar, publishedAt])
  @@index([contentFormat, publishedAt])
  @@index([utmContent])
  @@index([createdAt])

  metricSnapshots GrowthContentMetricSnapshot[]
}

enum GrowthContentMetricCheckpoint {
  INITIAL
  HOURS_72
  DAYS_7
}

/// Point-in-time Facebook Insights capture for a canonical content record.
/// One post = one GrowthContentRecord; checkpoints mature as snapshots.
model GrowthContentMetricSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  contentRecordId String
  contentRecord   GrowthContentRecord @relation(fields: [contentRecordId], references: [id], onDelete: Cascade)

  checkpoint GrowthContentMetricCheckpoint
  capturedAt DateTime @default(now())

  fbViews           Int?
  fbReach           Int?
  fbEngagements     Int?
  fbReactions       Int?
  fbComments        Int?
  fbShares          Int?
  fbPageVisits      Int?
  fbFollowersGained Int?
  fbLinkClicks      Int?

  notes            String? @db.VarChar(2000)
  capturedByEmail  String

  @@unique([contentRecordId, checkpoint])
  @@index([checkpoint, capturedAt])
  @@index([capturedAt])
}

enum GrowthExperimentDecisionKind {
  CONTINUE
  ITERATE
  PROMOTE
  STOP
  INCONCLUSIVE
}

/// Operator-entered Facebook experiment observations (manual; no Meta API).
model GrowthExperimentDecision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// e.g. 2026-012
  experimentId String @db.VarChar(40)

  hypothesis       String? @db.VarChar(1000)
  primaryMetric    String? @db.VarChar(120)
  secondaryMetrics String? @db.VarChar(500)
  observations     String  @db.VarChar(4000)
  sampleSize       Int?
  result           String? @db.VarChar(2000)
  confidence       String? @db.VarChar(20)
  decision         GrowthExperimentDecisionKind

  createdByEmail String

  @@index([experimentId, createdAt])
  @@index([createdAt])
}

