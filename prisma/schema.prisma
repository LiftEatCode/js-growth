  searchOpportunitySlug String? @db.VarChar(80)

  whyRecommendedJson Json
  briefJson          Json?
  /// AI draft payload (structured). Never auto-published.
  generationJson     Json?
  /// Human-edited canonical draft (preferred over generationJson when set).
  humanDraftJson     Json?
  /// AI-proposed revision. Never becomes canonical until explicit Apply.
  candidateDraftJson Json?
  reviewJson         Json?
  generationHistoryJson Json?

