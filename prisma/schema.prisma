/// Durable JS Solutions customer. Prospect ≠ Opportunity ≠ Client.
model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  primaryContactName  String?
  primaryContactEmail String?
  phone               String?

  website  String?
  hostname String?

  city  String?
  state String?

  sourceProspectId    String?  @unique
  sourceProspect      Prospect? @relation(fields: [sourceProspectId], references: [id], onDelete: SetNull)

  sourceOpportunityId String? @unique
  /// Soft reference — Opportunity also links clientId. No FK cycle.

  status ClientStatus @default(ACTIVE)

  createdByEmail String

  opportunities Opportunity[]
  projects      ClientProject[]

  @@index([hostname])
  @@index([status, createdAt])
  @@index([primaryContactEmail])
}

/// Delivery engagement created from an ACCEPTED Agreement (one per Opportunity).
model ClientProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  agreementId String @unique
  scopeId     String
  pricingId   String
  proposalId  String

  name   String
  status ClientProjectStatus @default(ONBOARDING)

  ownerEmail String

  startedAt   DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  /// Immutable commercial delivery snapshot at conversion (Sprint 10).
  commercialSnapshotJson Json

  onboardingVersion Int @default(1)

  createdByEmail String

  workstreams      ProjectWorkstream[]
  deliverables     ProjectDeliverable[]
  deliveryTasks    ProjectDeliveryTask[]
  onboardingItems  ProjectOnboardingItem[]
  activities       ProjectActivity[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([ownerEmail, status])
}

model ProjectWorkstream {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceScopeSectionId String?

  title            String
  capabilitiesJson Json
  sortOrder        Int
  status           ProjectWorkstreamStatus @default(NOT_STARTED)

  deliverables ProjectDeliverable[]

  @@index([projectId, sortOrder])
}

/// Client-readable commercial deliverable presentation (may share a delivery task).
model ProjectDeliverable {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workstreamId String
  workstream   ProjectWorkstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)

  deliveryTaskId String?
  deliveryTask   ProjectDeliveryTask? @relation(fields: [deliveryTaskId], references: [id], onDelete: SetNull)

  sourceScopeDeliverableId String?
  sourceActionKey          String?

  title       String
  description String?
  sortOrder   Int
  status      ProjectDeliverableStatus @default(NOT_STARTED)

  completedAt  DateTime?
  internalNotes String?

  @@index([projectId, sortOrder])
  @@index([workstreamId, sortOrder])
  @@index([deliveryTaskId])
}

/// Canonical execution unit — one completion even if multiple workstreams reference it.
model ProjectDeliveryTask {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Deterministic key: sourceActionKey or deliverable:{id}
  key String

  title       String
  description String?

  status ProjectDeliveryTaskStatus @default(NOT_STARTED)

  sourceScopeDeliverableIdsJson Json
  sourceWorkstreamIdsJson       Json
  capabilitiesJson              Json

  assignedToEmail String?
  dueAt           DateTime?
  completedAt     DateTime?
  internalNotes   String?

  deliverables ProjectDeliverable[]

  @@unique([projectId, key])
  @@index([projectId, status])
}

model ProjectOnboardingItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key         String
  label       String
  description String?

  status   OnboardingItemStatus @default(NOT_STARTED)
  required Boolean              @default(true)

  sortOrder Int

  completedAt DateTime?
  /// Operator notes only — never store credentials/passwords.
  notes       String?

  @@unique([projectId, key])
  @@index([projectId, sortOrder])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type ProjectActivityType

  actorEmail String

  fromValueJson Json?
  toValueJson   Json?
  note          String?

  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

