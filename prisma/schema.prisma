  @@index([auditReportId])
  @@index([comparisonSnapshotId])
  @@index([status, createdAt])
  @@index([leadId])
}

model ImplementationPlanWorkstream {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  implementationPlanId String
