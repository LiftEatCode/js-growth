# Environment variables for local development.
# Copy this file to `.env.local` and fill in real values.
# Never commit secrets.

DATABASE_URL=
DIRECT_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

REPORTS_ADMIN_EMAIL=
REPORTS_ADMIN_PASSWORD=
REPORTS_SESSION_SECRET=

CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Stripe — use TEST keys locally. Do not mix test Price IDs with live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFESSIONAL_AUDIT_PRICE_ID=

# Display-only. Must match the Stripe Price for Professional Website Growth Audit.
NEXT_PUBLIC_PROFESSIONAL_AUDIT_PRICE_LABEL="$99"

# Optional. When set, Google Analytics is loaded on the public site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OpenAI — Professional AI Interpretation and internal prospecting outreach
# drafts. Never prefix with NEXT_PUBLIC_. Free public audits must not use this key.
OPENAI_API_KEY=
# Optional OpenAI model ID. Defaults to gpt-4.1-mini when unset.
# Used for Professional AI Interpretation and Sprint 4 outreach drafts.
# Example: gpt-5.6-luna. Do not use Cursor chat model names here.
OPENAI_AUDIT_MODEL=

# Google Places API (New) — server-only. Never prefix with NEXT_PUBLIC_.
# Used by internal prospecting discovery. Restricted to Places API (New).
GOOGLE_PLACES_API_KEY=

# Google Business Profile Read Integration (Sprint 12.1) — server-only.
# OAuth web client. Redirect: {NEXT_PUBLIC_SITE_URL}/api/gbp/oauth/callback
# Scope: https://www.googleapis.com/auth/business.manage (app enforces READ-ONLY).
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=
# Optional explicit redirect; defaults to NEXT_PUBLIC_SITE_URL + /api/gbp/oauth/callback
GOOGLE_GBP_REDIRECT_URI=
# Optional 64-char hex or passphrase for AES-GCM refresh-token encryption.
# Falls back to key derived from REPORTS_SESSION_SECRET when unset.
GOOGLE_GBP_TOKEN_ENCRYPTION_KEY=
# GROWTH_TEST_MOCK_GBP=1 — acceptance/E2E mock provider (live Google = 0)

# Prefer a dedicated Neon branch. When unset, DB-backed commercial tests skip
# unless COMMERCIAL_E2E_USE_DEV_DB=1 (still refuses production-like URLs).
COMMERCIAL_TEST_DATABASE_URL=
# Shared acceptance / growth override (preferred for npm run test:acceptance):
# ACCEPTANCE_TEST_DATABASE_URL=
# GROWTH_TEST_DATABASE_URL=
# COMMERCIAL_E2E_USE_DEV_DB=1
# GROWTH_E2E_USE_DEV_DB=1
# ACCEPTANCE_E2E_USE_DEV_DB=1
# COMMERCIAL_TEST_MOCK_STRIPE=1 and COMMERCIAL_TEST_MOCK_RESEND=1 are set by commercial test runners.
# GROWTH_TEST_MOCK_AUDIT=1 — fixture audit (no live crawl) for growth E2E allowlisted hosts.
